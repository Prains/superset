{
	"name": "@superset/workspace-protocol",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./errors": {
			"types": "./src/errors/index.ts",
			"default": "./src/errors/index.ts"
		},
		"./events": {
			"types": "./src/events/index.ts",
			"default": "./src/events/index.ts"
		},
		"./routes": {
			"types": "./src/routes/index.ts",
			"default": "./src/routes/index.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "tsc --noEmit --emitDeclarationOnly false",
		"test": "bun test --pass-with-no-tests"
	},
	"dependencies": {
		"@superset/shared": "workspace:*",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@superset/typescript": "workspace:*",
		"@types/bun": "1.3.14",
		"@types/node": "24.12.0",
		"typescript": "6.0.3"
	}
}
